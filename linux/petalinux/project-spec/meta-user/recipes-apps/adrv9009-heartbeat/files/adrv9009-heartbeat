#!/bin/sh
# Start the board LED only after the ADRV9009 JESD204 FSM completes.
# The sysfs override is for offline validation; normal boots use /sys.
sysfs=${ADRV9009_HEARTBEAT_SYSFS:-/sys}
led="$sysfs/class/leds/adrv9009:heartbeat"
mode=unknown

read_attr() {
    cat "$1" 2>/dev/null
}

radio_ready() {
    for dev in "$sysfs"/bus/iio/devices/iio:device*; do
        [ "$(read_attr "$dev/name")" = adrv9009-phy ] || continue
        [ "$(read_attr "$dev/jesd204_fsm_ctrl")" = 1 ] || return 1
        [ "$(read_attr "$dev/jesd204_fsm_error")" = 0 ] || return 1
        [ "$(read_attr "$dev/jesd204_fsm_paused")" = 0 ] || return 1
        [ "$(read_attr "$dev/jesd204_fsm_state")" = opt_post_running_stage ] || return 1
        return 0
    done
    return 1
}

led_off() {
    [ -w "$led/trigger" ] && [ -w "$led/brightness" ] || return 1
    printf 'none\n' > "$led/trigger" || return 1
    printf '0\n' > "$led/brightness"
}

led_blink() {
    [ -w "$led/trigger" ] || return 1
    printf 'timer\n' > "$led/trigger" || return 1
    printf '500\n' > "$led/delay_on" || return 1
    printf '500\n' > "$led/delay_off"
}

trap 'exit 0' TERM INT
trap 'led_off >/dev/null 2>&1 || :' EXIT

while :; do
    if radio_ready; then
        if [ "$mode" != ready ]; then
            if led_blink; then
                mode=ready
                logger -t adrv9009-heartbeat 'ADRV9009 initialized; LED heartbeat enabled'
            else
                led_off >/dev/null 2>&1 || :
            fi
        fi
    elif [ "$mode" != waiting ]; then
        if led_off; then
            mode=waiting
            logger -t adrv9009-heartbeat 'Waiting for ADRV9009 initialization; LED off'
        fi
    fi
    sleep 1
done
